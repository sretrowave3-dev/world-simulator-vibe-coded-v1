# =============================================================================
# Git Ignore Rules for World Simulator Subfolder
# =============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Environment files and credentials
.env
.env.*
!.env.example
*.key
*.pem

# Local simulation saves and states
saves/
*.dat
*.dat.*
*.meta.json

# Simulation logs and audit records
security_audit.jsonl
seeds_log.json
*.log
auto_debugger_crash_dump.json
*_crash_dump.json

# Scratch and debug artifacts
scratch/__pycache__/

# Testing and coverage
.pytest_cache/
.coverage
htmlcov/

# IDE / Editor configuration
.vscode/
.idea/
*.swp
*.swo

# Operating System files
.DS_Store
Thumbs.db
desktop.ini
